.venv/
__pycache__/
*.pyc

# Scans are data, not source, and they are large -- keep them out.
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.webp

# ...except the sample sheet, so a fresh clone has something to open.
!samples/*.jpg

# Measurements are small, diff well, and are worth having on both machines.
!results/*.csv
!results/*.json
